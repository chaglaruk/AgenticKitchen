CREATE TABLE RecipeHistory (
    id TEXT NOT NULL PRIMARY KEY,
    name TEXT NOT NULL,
    ingredients TEXT NOT NULL,
    timestamp TEXT NOT NULL,
    status TEXT NOT NULL
);

CREATE TABLE PantryItem (
    id TEXT NOT NULL PRIMARY KEY,
    canonicalIngredientId TEXT,
    originalName TEXT NOT NULL,
    displayNameTr TEXT,
    displayNameEn TEXT,
    quantity REAL NOT NULL,
    unit TEXT NOT NULL,
    unitDimension TEXT NOT NULL,
    packageLabel TEXT,
    isEstimated INTEGER NOT NULL,
    confidence REAL,
    source TEXT NOT NULL,
    createdAt TEXT NOT NULL,
    updatedAt TEXT NOT NULL
);

CREATE TABLE InventoryAdjustment (
    id TEXT NOT NULL PRIMARY KEY,
    itemId TEXT NOT NULL,
    amount REAL NOT NULL,
    mode TEXT NOT NULL,
    reason TEXT NOT NULL,
    source TEXT NOT NULL,
    timestamp TEXT NOT NULL
);

CREATE TABLE PendingRecipeUsage (
    sessionId TEXT NOT NULL,
    itemId TEXT NOT NULL,
    plannedQuantity REAL NOT NULL,
    unit TEXT NOT NULL,
    actualQuantity REAL,
    status TEXT NOT NULL,
    timestamp TEXT NOT NULL,
    PRIMARY KEY (sessionId, itemId)
);

selectAll:
SELECT * FROM RecipeHistory ORDER BY timestamp DESC;

insertRecipe:
INSERT OR REPLACE INTO RecipeHistory(id, name, ingredients, timestamp, status)
VALUES (?, ?, ?, ?, ?);

updateRecipeStatus:
UPDATE RecipeHistory SET status = ? WHERE id = ?;

deleteRecipe:
DELETE FROM RecipeHistory WHERE id = ?;

clearHistory:
DELETE FROM RecipeHistory;

selectAllPantryItems:
SELECT * FROM PantryItem ORDER BY updatedAt DESC;

selectPantryItem:
SELECT * FROM PantryItem WHERE id = ?;

upsertPantryItem:
INSERT OR REPLACE INTO PantryItem(
    id, canonicalIngredientId, originalName, displayNameTr, displayNameEn,
    quantity, unit, unitDimension, packageLabel, isEstimated, confidence,
    source, createdAt, updatedAt
) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

deletePantryItem:
DELETE FROM PantryItem WHERE id = ?;

insertInventoryAdjustment:
INSERT INTO InventoryAdjustment(id, itemId, amount, mode, reason, source, timestamp)
VALUES (?, ?, ?, ?, ?, ?, ?);

selectInventoryAdjustments:
SELECT * FROM InventoryAdjustment WHERE itemId = ? ORDER BY timestamp DESC;

upsertPendingRecipeUsage:
INSERT OR REPLACE INTO PendingRecipeUsage(
    sessionId, itemId, plannedQuantity, unit, actualQuantity, status, timestamp
) VALUES (?, ?, ?, ?, ?, ?, ?);

selectPendingRecipeUsage:
SELECT * FROM PendingRecipeUsage WHERE sessionId = ? ORDER BY itemId;

selectAllPendingRecipeUsage:
SELECT * FROM PendingRecipeUsage ORDER BY timestamp;

deletePendingRecipeUsage:
DELETE FROM PendingRecipeUsage WHERE sessionId = ?;

CREATE TABLE ActiveCookingSession (
    sessionId TEXT NOT NULL PRIMARY KEY,
    recipeOptionId TEXT NOT NULL,
    recipeName TEXT NOT NULL,
    recipeType TEXT NOT NULL,
    description TEXT NOT NULL,
    sourceLabel TEXT,
    servings INTEGER NOT NULL,
    resolvedReadyTimeIso TEXT NOT NULL,
    cookingPlanJson TEXT NOT NULL,
    eventsJson TEXT NOT NULL,
    plannedUsageJson TEXT NOT NULL,
    status TEXT NOT NULL,
    startedAtMillis INTEGER NOT NULL,
    accumulatedElapsedSeconds INTEGER NOT NULL,
    lastRunningStartMillis INTEGER,
    pausedAtMillis INTEGER,
    completedStepIds TEXT NOT NULL,
    skippedStepIds TEXT NOT NULL,
    recentChatTurnsJson TEXT NOT NULL,
    updatedAtIso TEXT NOT NULL
);

upsertActiveCookingSession:
INSERT OR REPLACE INTO ActiveCookingSession(
    sessionId, recipeOptionId, recipeName, recipeType, description, sourceLabel,
    servings, resolvedReadyTimeIso, cookingPlanJson, eventsJson, plannedUsageJson,
    status, startedAtMillis, accumulatedElapsedSeconds, lastRunningStartMillis,
    pausedAtMillis, completedStepIds, skippedStepIds, recentChatTurnsJson, updatedAtIso
) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

selectActiveCookingSession:
SELECT * FROM ActiveCookingSession WHERE sessionId = ?;

selectAllActiveCookingSessions:
SELECT * FROM ActiveCookingSession ORDER BY updatedAtIso DESC;

deleteActiveCookingSession:
DELETE FROM ActiveCookingSession WHERE sessionId = ?;

clearActiveCookingSessions:
DELETE FROM ActiveCookingSession;
