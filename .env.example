# Agentic Kitchen - Environment Configuration
# Copy this file to .env and fill in your values.
# DO NOT commit the actual .env file to the repository.

# Gemini API Key (optional - free providers work without this)
# Get yours at: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Hugging Face API Key (optional - for HuggingFace provider)
# Get yours at: https://huggingface.co/settings/tokens
HUGGINGFACE_API_KEY=
